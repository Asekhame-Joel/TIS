DirectoryIndex index.php
Options -Indexes
RewriteEngine On

# HTML is controlled by PHP and revalidated on every visit. Static assets use
# content-versioned URLs and can therefore be cached aggressively.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|mjs|webp|png|jpe?g|gif|svg|ico|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set CDN-Cache-Control "public, max-age=31536000, immutable"
    Header set Cloudflare-CDN-Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<Files "_bootstrap.php">
  Require all denied
</Files>

# Application code is deployed with the website, but must never be served.
RewriteRule ^(?:app|config|scripts|vendor)/ - [F,L,NC]
RewriteRule ^(?:composer\.(?:json|lock))$ - [F,L,NC]

# API calls must keep their HTTP method and request body.
RewriteRule ^api/ - [L]

# Redirect explicit legacy page filenames to clean public URLs.
RewriteCond %{THE_REQUEST} \s/+index\.(?:html|php)[\s?] [NC]
RewriteRule ^index\.(?:html|php)$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.(?:html|php)[\s?] [NC]
RewriteRule ^(.+?)\.(?:html|php)$ /$1 [R=301,L]

# Internally serve extensionless routes from their PHP page.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]
